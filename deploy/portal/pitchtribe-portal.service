[Unit]
Description=PitchTribe guest Wi-Fi captive portal
After=network.target hostapd.service

[Service]
Type=simple
User=pitchtribe
Group=pitchtribe
WorkingDirectory=/opt/pitchtribe/app
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/pitchtribe
Environment=PORTAL_HOST=10.42.0.1
Environment=PORTAL_PORT=8082
ExecStart=/usr/bin/env node /opt/pitchtribe/app/portal-server.js
Restart=always
RestartSec=3

# Only privilege: adding guests to the nftables "allowed" set.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pitchtribe
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
