/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests

# Asset filenames are content-hashed by scripts/fingerprint.mjs, so a given
# URL never changes content and can be cached hard. A new build produces new
# URLs, which is what makes CSS changes land immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The one-line installer (deploy/bootstrap.sh, copied in by `npm run
# copy:install`). Served as text/plain so anyone can read it in a browser before
# piping it into a shell, and cached only briefly because, unlike /assets/*, its
# filename is not content-hashed.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
