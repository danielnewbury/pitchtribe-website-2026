<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Only canonical, non-redirecting URLs belong here. pitchtribe.co.uk 301s to
       pitchtribe.media, so listing it would point crawlers at a redirect. -->
  <url>
    <loc>https://pitchtribe.media/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!-- Extensionless: Cloudflare Pages serves buy.html at /buy and redirects
       /buy.html there, so /buy is the canonical form. -->
  <url>
    <loc>https://pitchtribe.media/buy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
